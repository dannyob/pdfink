# Commands for pdfink's pen menu (server mode). Copy this file to
# pdfink-commands.conf in the notebooks folder, or point --commands at it.
#
# One section per menu item. The command runs under `sh -c` in this file's
# folder, after the notebook has been saved, with these variables set:
#   $PDF (path)  $NAME  $NOTEBOOKS  $PAGE (1-based)  $PAGES
#   $X $Y        pen position in PDF points, origin bottom-left
#   $DX $DY      the same in display points, origin top-left
#   $PAGE_WIDTH $PAGE_HEIGHT $ROTATE
#   $SELECTED    number of selected items, empty without a selection
#   $SEL_PAGE $SEL_X $SEL_Y $SEL_W $SEL_H   the selection's box, PDF points
#   $PDFINK_SOCKET  a socket for talking to the page (tools/pdfink_page.py)
#   $PDFINK_RUN  this run's identifier
# Flags: reload (reopen the notebook afterwards), confirm (ask first),
# timeout (seconds, default 60; 0 = no timeout, the default for detached
# commands), detach (keep running after the menu returns, with a chip in the
# toolbar).
#
# Commands run with no screen. On macOS, keep them out of Desktop, Documents
# and Downloads (and symlinks into them): the system wants a consent dialog
# for those, nobody can click it, and the command hangs until its timeout.

[Draw a star here]
# Draws in the browser through the page bridge; without a page it rewrites
# the file instead, and reload shows the result.
command = uv run --script tools/star.py "$PDF" "$PAGE" "$X" "$Y"
reload = true

[Timestamp]
# A red chevron and the date and time in ink at the pen tip, plus a bookmark
# titled with them; journal-page.py dates the entry from that bookmark.
command = uv run --script tools/timestamp.py "$PDF" "$PAGE" "$X" "$Y" --page-width "$PAGE_WIDTH"
reload = true

[Describe selection]
# Sends a PNG of the selection (or the page) to a vision model through llm
# and offers the answer in a dialog; see tools/describe-selection.py.
command = uv run --script tools/describe-selection.py
timeout = 300

[Recognise handwriting]
# Groups the page's ink into lines, has a vision model read them (llm), and
# keeps the words in the PDF as invisible, searchable text; see
# tools/ocr-page.py. Only lines that changed since the last run are sent;
# with a selection, only the lines inside it.
command = uv run --script tools/ocr-page.py "$PAGE"
timeout = 300

[Journal this page]
# Transcribes the page with a vision model (simonw's llm) and files it in a
# journal; see tools/journal-page.py. Slow, so it asks first and gets time.
# It also bookmarks the page with the entry's date, through the page bridge.
# Any script can do the same with add_bookmark, or put a web link on the page
# with add_link (tools/pdfink_page.py).
command = uv run --script tools/journal-page.py "$PDF" "$PAGE"
confirm = true
timeout = 900

[Remind me in five minutes]
# Detached: the menu returns at once and a chip in the toolbar shows the run;
# dismiss the chip to cancel. Speaks to the page with nc instead of Python.
command = sleep 300 && printf '{"id":1,"call":"toast","args":["five minutes are up"]}\n' | nc -U "$PDFINK_SOCKET"
detach = true

[Copy page number to a note]
command = printf 'page %s of %s at %s,%s\n' "$PAGE" "$PAGES" "$X" "$Y" >> "$NOTEBOOKS/notes.txt"

[Print this page]
command = lp -o page-ranges="$PAGE" "$PDF"
confirm = true
